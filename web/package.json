{
  "name": "event-rec",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "npm run build:node",
    "build:node": "node scripts/build-node.mjs",
    "start": "npm run start:node",
    "start:node": "node dist-node/server.js",
    "lint": "oxlint",
    "format": "oxfmt",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:smoke": "npm run test:smoke:node",
    "typecheck": "tsc --noEmit",
    "data:refresh": "node --experimental-strip-types scripts/refresh.ts",
    "local:setup": "node scripts/local-setup.mjs",
    "local:start": "node scripts/local-start.mjs",
    "local:refresh": "node scripts/local-refresh.mjs",
    "embeddings:index": "node scripts/index-embeddings.mjs",
    "test:browser": "playwright test",
    "test:smoke:node": "node scripts/smoke-node.mjs",
    "test:input-intent": "node --experimental-strip-types scripts/check-input-intent.mjs",
    "test:golden": "node --experimental-strip-types scripts/golden-run.ts",
    "eval:plan": "node --experimental-strip-types scripts/plan-eval.ts",
    "eval:agent": "node --experimental-strip-types scripts/agent-eval.ts"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@google-cloud/firestore": "9.4.0",
    "@google-cloud/storage": "8.4.0",
    "@google/adk": "2.4.0",
    "@google/genai": "2.32.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "firebase": "13.2.0",
    "lucide-react": "1.70.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-server-dom-webpack": "19.3.1",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "vinext": "1.4.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "22.19.19",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.2.1",
    "@vitejs/plugin-rsc": "0.5.39",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "8.3.6"
  },
  "type": "module",
  "imports": {
    "#event-rec/store": "./lib/store.node.ts"
  },
  "overrides": {
    "@google/adk": {
      "@google-cloud/storage": "$@google-cloud/storage"
    },
    "@grpc/grpc-js": "1.14.7",
    "fflate": "0.7.5"
  }
}
